# Evaluation configuration: start with ./webserv and open http://127.0.0.1:8080/
# The guide page walks through every evaluation-sheet check against these routes.

# Logging: error (default) or debug (a line for every connection, request and response).
log_level error;

# Website 1: the evaluation guide, reachable on every interface.
server {
    listen 8080;
    host 0.0.0.0;

    server_name localhost;
    client_max_body_size 10M;

    error_page 404 ./contents/errors/404.html;
    error_page 500 ./contents/errors/500.html;

    # Guide pages. GET only, so nothing here can be deleted during the evaluation.
    # Directories without an index file (e.g. /no-index/) answer 403.
    location / {
        root ./contents;
        index index.html;
        allowed_methods GET;
        autoindex off;
    }

    # Route mapped to another directory: /files/x -> ./contents/files/x.
    # Read-only with a directory listing; DELETE here is 405.
    location /files {
        root ./contents/files;
        allowed_methods GET;
        autoindex on;
    }

    # Uploads: POST stores, GET serves, DELETE removes, all in upload_store.
    location /uploads {
        allowed_methods GET POST DELETE;
        autoindex on;
        upload on;
        upload_store ./contents/uploads;
    }

    # CGI by file extension; two interpreters for the bonus.
    location /cgi {
        root ./contents/cgi;
        allowed_methods GET POST;
        cgi .py /usr/bin/python3;
        cgi .sh /bin/bash;
    }

    location /old-page {
        return 301 /;
    }

    # Bonus: cookie-backed session visit counter.
    location /session {
        allowed_methods GET;
        session_demo on;
    }
}

# Website 2: different interface, port, content, 404 page, and a tiny body limit.
server {
    listen 8081;
    host 127.0.0.1;

    server_name second.local;
    client_max_body_size 32;

    error_page 404 ./contents/secondary/errors/404.html;

    location / {
        root ./contents/secondary;
        index index.html;
        allowed_methods GET;
    }

    # POST target for the body-limit check: up to 32 bytes -> 200, more -> 413.
    location /cgi {
        root ./contents/cgi;
        allowed_methods GET POST;
        cgi .sh /bin/bash;
    }
}
