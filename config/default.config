server {
    listen 8080;
    host 0.0.0.0;
    
    server_name localhost;
    client_max_body_size 10M;
    
    error_page 404 ./contents/errors/404.html;
    error_page 500 ./contents/errors/500.html;
    
    location / {
        root ./contents;
        index index.html;
        allowed_methods GET POST DELETE;
        autoindex off;
    }
    
    location /files {
        root ./contents;
        allowed_methods GET;
        autoindex on;
    }
    
    location /uploads {
        allowed_methods GET POST DELETE;
        autoindex on;
        upload on;
        upload_store ./contents/uploads;
    }
    
    location /cgi {
        allowed_methods GET POST;
        cgi .py /usr/bin/python3;
        cgi .sh /bin/bash;
    }
    
    location /old-page {
        return 301 /;
    }

    location /session {
        allowed_methods GET;
        session_demo on;
    }
}