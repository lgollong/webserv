server {
    listen 8002;
    host 127.0.0.1;

    server_name mywebsite.com;
    client_max_body_size 10M;

    error_page 404 ./contents/errors/404.html;
    error_page 500 ./contents/errors/500.html;

    location / {
        root ./contents;
        index index.html;
        allowed_methods GET POST DELETE;
        autoindex off;
    }

    location /static {
        root ./contents/files;
        allowed_methods GET;
        autoindex on;
    }

    location /uploads {
        allowed_methods POST DELETE;
        upload on;
        upload_store ./contents/uploads;
    }

    location /cgi {
        allowed_methods GET POST;
        cgi .php /usr/bin/php-cgi;
        cgi .py /usr/bin/python3;
        cgi .sh /bin/bash;
    }
    location /redirect-test {
        return 301 /;
    }

    location /docs {
        root ./contents;
        index index.html;
        allowed_methods GET;
        autoindex on;
    }
}

