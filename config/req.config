server {
    listen 8008;
    host 127.0.0.1;

    server_name api.local;
    client_max_body_size 5M;

    error_page 404 ./contents/errors/404.html;
    error_page 500 ./contents/errors/500.html;

    location / {
        root ./contents/secondary;
        index index.html;
        allowed_methods GET POST;
    }

    location /api {
        allowed_methods GET POST PUT DELETE;
        autoindex on;
    }

    location /api/upload {
        allowed_methods POST;
        upload on;
        upload_store ./contents/uploads;
    }
}

server {
    listen 8001;
    host 127.0.0.1;

    server_name admin.local;
    client_max_body_size 2M;

    error_page 404 ./contents/errors/404.html;
    error_page 500 ./contents/errors/500.html;

    location / {
        root ./contents;
        index index.html;
        allowed_methods GET POST DELETE;
    }

    location /cgi {
        allowed_methods GET POST;
        cgi .php /usr/bin/php-cgi;
        cgi .py /usr/bin/python3;
    }
}
