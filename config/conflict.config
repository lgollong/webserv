# Port-issue check: two servers on the same interface:port.
# webserv does not implement virtual hosts, so startup must fail cleanly:
#   ./webserv config/conflict.config
#   ERROR: bind: Address already in use

server {
    listen 8090;
    host 127.0.0.1;
    server_name first.local;

    location / {
        root ./contents;
        index index.html;
    }
}

server {
    listen 8090;
    host 127.0.0.1;
    server_name second.local;

    location / {
        root ./contents/secondary;
        index index.html;
    }
}
