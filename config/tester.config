# Configuration for the 42 tester: ./tester http://localhost:8080
# Start the server from the project root: ./webserv config/tester.config
# The cgi path must be absolute; adjust it when the project lives elsewhere.

server {
    listen 8080;
    host 0.0.0.0;
    server_name localhost;

    # The tester sends bodies of 100000000 bytes to the .bla CGI.
    client_max_body_size 100M;

    # / answers GET only.
    location / {
        root ./YoupiBanane;
        index youpi.bad_extension;
        allowed_methods GET;
    }

    # /post_body answers any POST with a body of at most 100 bytes.
    location /post_body {
        allowed_methods POST;
        client_max_body_size 100;
    }

    # /directory/ serves YoupiBanane and falls back to youpi.bad_extension.
    # The tester also POSTs .bla files here, including missing ones (youpla.bla),
    # which go to cgi_tester.
    location /directory {
        root ./YoupiBanane;
        index youpi.bad_extension;
        allowed_methods GET POST;
        cgi .bla /home/lgollong/webserv/webserv/cgi_tester;
        cgi_require_script off;
    }
}
